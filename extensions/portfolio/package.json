{
  "name": "portfolio",
  "displayName": "Portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Runs the portfolio site: in-memory workspace, startup layout, theme toggle",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "local",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "portfolio.toggleTheme",
        "title": "Toggle Light / Dark Theme",
        "category": "Portfolio",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "portfolio.toggleTheme",
          "group": "navigation@-1"
        }
      ]
    }
  },
  "activationEvents": [
    "onFileSystem:memfs",
    "onStartupFinished"
  ],
  "extensionKind": [
    "web"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
